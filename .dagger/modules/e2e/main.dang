"""
End-to-end checks for the vitest toolchain.
"""
type E2e {
  """
  The git repository to run tests against as an end-to-end smoke test.
  """
  pub repo: String! = "https://github.com/dagger/hello-dagger"

  """
  Run the vitest toolchain against a real-world repository.

  This pulls the hello-dagger repo, exposes it as a Workspace, and runs
  the vitest `testAll` check against it end-to-end.
  """
  pub testHelloDagger: Void @check {
    let ws = git(repo).head.tree.asWorkspace

    vitest().testAll(ws)
  }

  """
  A single Vitest project, used as the building block of the synthetic
  multi-project workspaces below. The git metadata is dropped so a copy nested
  inside another copy is an ordinary subdirectory rather than a repository.
  """
  let project: Directory! {
    git(repo).head.tree.filter(exclude: [".git"])
  }

  """
  Two sibling projects under a root that holds no config of its own:

      a/vitest.config.ts
      b/vitest.config.ts
  """
  let siblings: Directory! {
    directory.
      withDirectory("a", project).
      withDirectory("b", project)
  }

  """
  A root project with a project nested under each of two subdirectories:

      vitest.config.ts
      a/vitest.config.ts
      b/vitest.config.ts
  """
  let nested: Directory! {
    project.
      withDirectory("a", project).
      withDirectory("b", project)
  }

  """
  Discovery from `cwd` inside a synthetic workspace built from `tree`.
  """
  let projects(tree: Directory!, cwd: String!): [String!]! {
    vitest().projects(tree.asWorkspace(cwd: cwd))
  }

  """
  Fail unless discovery returned exactly the wanted paths, in any order.
  """
  let assertPaths(got: [String!]!, want: [String!]!, context: String!): Void {
    let rendered = context + ": got [" + got.join(", ") + "], want [" + want.join(", ") + "]"

    if (got.length != want.length) {
      raise rendered
    }
    want.each { path =>
      if (got.filter { value => value == path }.length != 1) {
        raise rendered
      }
    }
    null
  }

  """
  From a root holding no config, discovery returns every project beneath it;
  entering one of them scopes discovery to that project alone.
  """
  pub siblingDiscoveryCheck: Void @check {
    assertPaths(projects(siblings, "."), ["a", "b"], "from the workspace root")
    assertPaths(projects(siblings, "a"), ["."], "from a")
    assertPaths(projects(siblings, "b"), ["."], "from b")

    null
  }

  """
  A root project does not leak into a nested project's view: the config in the
  cwd shadows the enclosing one, so entering `a` yields `a` alone.
  """
  pub nestedDiscoveryCheck: Void @check {
    assertPaths(projects(nested, "."), [".", "a", "b"], "from the workspace root")
    assertPaths(projects(nested, "a"), ["."], "from a")
    assertPaths(projects(nested, "b"), ["."], "from b")

    null
  }

  """
  A root project with a nested project under a subdirectory holding no config
  of its own:

      vitest.config.ts
      work/                  <- no config
      work/app/vitest.config.ts
  """
  let ancestor: Directory! {
    project.withDirectory("work/app", project)
  }

  """
  From a subdirectory holding no config, the nearest enclosing project is
  reported as a ".."-relative path alongside the projects below the cwd, and
  that path resolves back to the enclosing project through the workspace.
  """
  pub ancestorDiscoveryCheck: Void @check {
    let ws = ancestor.asWorkspace(cwd: "work")

    assertPaths(vitest().projects(ws), ["..", "app"], "from work")

    if (ws.directory("..").glob("vitest.config.ts").length != 1) {
      raise "the returned ancestor path did not resolve back to the enclosing project"
    }

    null
  }

  """
  A failing test file, used to observe which projects a run actually covered.
  """
  let failingTest: String! = "import { expect, test } from 'vitest'\ntest('fails', () => { expect(1).toBe(2) })\n"

  """
  Whether `testAll` from `cwd` observed the failure planted in `tree`.
  """
  let testAllFailed(tree: Directory!, cwd: String!): Boolean! {
    try {
      vitest().testAll(tree.asWorkspace(cwd: cwd))
      false
    } catch {
      err => true
    }
  }

  """
  `testAll` runs every project below the cwd, and entering one of them leaves
  its siblings out of reach.
  """
  pub descendantScopeCheck: Void @check {
    let broken = siblings.withNewFile("b/src/broken.test.ts", failingTest)

    if (testAllFailed(broken, ".") == false) {
      raise "testAll from the workspace root should have run the project b"
    }
    if (testAllFailed(broken, "a")) {
      raise "testAll from a should not have run the sibling project b"
    }
    if (testAllFailed(siblings.withNewFile("a/src/broken.test.ts", failingTest), "a") == false) {
      raise "testAll from a should have run a's own tests"
    }

    null
  }

  """
  A cwd holding no config sits inside its enclosing project, so `testAll` runs
  that project too rather than only the ones below the cwd.
  """
  pub ancestorScopeCheck: Void @check {
    if (testAllFailed(ancestor.withNewFile("src/broken.test.ts", failingTest), "work") == false) {
      raise "testAll from work should have run the enclosing project"
    }

    null
  }

  """
  A test in project `a` reading a fixture at the workspace root by a relative
  path that escapes the project directory.
  """
  let fixtureTest: String! = "import { readFileSync } from 'node:fs'\nimport { join } from 'node:path'\nimport { expect, test } from 'vitest'\ntest('shared fixture', () => {\n  const fixture = JSON.parse(readFileSync(join(__dirname, '../../fixtures/shared.json'), 'utf8'))\n  expect(fixture.greeting).toBe('hello')\n})\n"

  """
  The sibling projects plus a fixture shared at the workspace root, asserted
  against by a test in `a`:

      fixtures/shared.json
      a/src/shared.test.ts   <- reads ../../fixtures/shared.json
      b/vitest.config.ts
  """
  let sharedFixture: Directory! {
    siblings.
      withNewFile("fixtures/shared.json", "{\"greeting\": \"hello\"}\n").
      withNewFile("a/src/shared.test.ts", fixtureTest)
  }

  """
  Without `includeExtraFiles` a file outside the project is not in the
  container; with it, the file is mounted at its workspace-relative path so the
  test's relative import resolves as it does on disk.
  """
  pub includeExtraFilesCheck: Void @check {
    if (testAllFailed(sharedFixture, "a") == false) {
      raise "the fixture outside the project should not have been reachable by default"
    }

    vitest(includeExtraFiles: ["fixtures/**"]).testAll(sharedFixture.asWorkspace(cwd: "a"))

    null
  }

  """
  A ".."-relative project path resolves to the same workspace-relative mount:
  from a subdirectory of `a`, the enclosing project still reaches the shared
  fixture through `includeExtraFiles`.
  """
  pub includeExtraFilesAncestorCheck: Void @check {
    vitest(includeExtraFiles: ["fixtures/**"]).testAll(sharedFixture.withDirectory("a/work", directory).asWorkspace(cwd: "a/work"))

    null
  }
}
