"""
Toolchain to execute Vitest tests
"""
type Vitest {
  """
  The base image to use.
  """
  pub baseImageAddress: String! = "node:25-alpine"

  """
  The package manager to use.
  """
  pub packageManager: String! = "npm"

  """
  Filenames that mark a Vitest project: Vitest reads its own `vitest.config.*`
  and falls back to `vite.config.*`.
  """
  let configNames: [String!]! = [
    "vitest.config.ts",
    "vitest.config.mts",
    "vitest.config.cts",
    "vitest.config.js",
    "vitest.config.mjs",
    "vitest.config.cjs",
    "vite.config.ts",
    "vite.config.mts",
    "vite.config.cts",
    "vite.config.js",
    "vite.config.mjs",
    "vite.config.cjs",
  ]

  """
  The Vitest projects visible from the client's cwd: every project at or below
  it, plus the nearest enclosing project when the cwd holds no config of its
  own. Paths are cwd-relative, so a ".." prefix marks an enclosing project.
  """
  pub projects(ws: Workspace!): [String!]! {
    polyfill().workspace(ws).findConfigDirs(
      configNames,
      exclude: ["**/node_modules/**"],
    )
  }

  """
  Execute the tests of every project visible from the client's cwd. A cwd that
  holds no config of its own sits inside its enclosing project, so that project
  runs too; enter a subproject to run it alone.
  """
  pub testAll(
  ws: Workspace!,
  """
  Run build before test
  """
  build: Boolean! = false,
  """
  Flags to pass to vitest
  """
  flags: [String!]! = []
  ): Void @check {
    projects(ws).each { path => test(ws, path: path, build: build, flags: flags) }

    null
  }

  """
  Execute the tests of a single project
  """
  pub test(
  ws: Workspace!,
  """
  Path of the project to test, relative to the client's cwd
  """
  path: String! = ".",
  """
  List of files to test
  """
  files: [String!]! = [],
  """
  Run build before test
  """
  build: Boolean! = false,
  """
  Flags to pass to vitest
  """
  flags: [String!]! = []
  ): Void {
    let runtime = base(ws, path)

    # optionally build first
    if (build) {
      runtime = runtime.withExec([packageManager, "run", "build"])
    }

    # install the local build of the otel library
    let installLibrary = [packageManager, "install", "-D", "/vitest", "--install-links"]
    # yarn uses add instead of install
    if (packageManager == "yarn") {
      installLibrary = [packageManager, "add", "--dev", "/vitest"]
    }

    # pnpm needs -w
    if (packageManager == "pnpm") {
      installLibrary = [packageManager, "install", "-w", "-D", "/vitest", "--no-link-workspace-packages"]
    }

    # Install vitest library
    runtime = runtime.
      withMountedDirectory("/vitest", buildLibrary).
      withExec(installLibrary)

    # mount and install the otel library and then execute the tests
    runtime.
      withEnvVariable("NODE_OPTIONS", "$NODE_OPTIONS --import /vitest/dist/esm/register.mjs", expand: true).
      withEnvVariable("DAGGER_VITEST_CACHE_BUSTER", UUID.v7).
      withExec(["npx", "vitest"] + flags + files).
      sync

    null
  }

  """
  List the tests of a single project
  """
  pub list(
  ws: Workspace!,
  """
  Path of the project to list, relative to the client's cwd
  """
  path: String! = "."
  ): String {
    let cmd = ["npx", "vitest", "list"]

    base(ws, path).
      withExec(cmd).
      stdout
  }

  """
  The source directory of a project, relative to the client's cwd
  """
  pub source(
  ws: Workspace!,
  """
  Path of the project, relative to the client's cwd
  """
  path: String! = "."
  ): Directory! {
    ws.directory(path, exclude: ["**/node_modules", "dist", "build"])
  }

  """
  Runtime container for executing the tests of a project
  """
  let base(ws: Workspace!, path: String!): Container! {
    # set cache variables for all supported package managers
    let base = container.from(baseImageAddress).
      withMountedCache("/root/.packages", cacheVolume("node-toolchain-packages")).
      withEnvVariable("npm_config_cache", "/root/.packages").
      withEnvVariable("YARN_CACHE_FOLDER", "/root/.packages").
      withEnvVariable("PNPM_HOME", "/root/.packages").
      withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.packages")

    if (packageManager == "pnpm" and baseImageAddress.contains("node:")) {
      base = base.withExec(["corepack", "enable"])
    }

    base.
      withDirectory("/src", source(ws, path: path)).
      withWorkdir("/src").
      withEnvVariable("CI", "true").
      withExec([packageManager, "install"])
  }

  """
  Build the otel library
  """
  let buildLibrary: Directory! {
    let module = currentModule.source.filter(exclude: ["tests", "vitest.dang", "dagger.json", "biome.json", "dist", "node_modules"])

    container.from("oven/bun:1.3.0-alpine@sha256:37e6b1cbe053939bccf6ae4507977ed957eaa6e7f275670b72ad6348e0d2c11f").
      withMountedCache("/root/.bun/install/cache", cacheVolume("library-node-modules")).
      withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.bun/install/cache").
      withDirectory("/src", module).
      withWorkdir("/src").
      withExec(["bun", "install"]).
      withExec(["bun", "run", "build"]).
      directory("/src")
  }
}
