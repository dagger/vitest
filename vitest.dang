"""
Toolchain to execute Vitest tests
"""
type Vitest {
  """
  The base image to use.
  """
  baseImageAddress: String! = "node:25-alpine"

  """
  Package manager that installs dependencies: npm, yarn, pnpm or bun. Empty
  detects it from package.json's packageManager field, else the lockfile,
  else npm.
  """
  packageManager: String! = ""

  """
  Extra workspace-root include patterns mounted alongside the project directory,
  at their workspace-relative paths, so relative imports that escape the project
  resolve as they do on disk. Use this for fixtures or schemas shared with code
  elsewhere in a monorepo, e.g. ["testdata/**", "schema/*.json"].
  """
  includeExtraFiles: [String!]! = []

  """
  Run the package manager's build script before the tests.
  """
  build: Boolean! = false

  """
  Flags to pass to every vitest run.
  """
  flags: [String!]! = []

  """
  Flags appended to the install command, e.g. ["--ignore-scripts"].
  """
  installFlags: [String!]! = []

  """
  Environment variables for the install and the tests, as KEY=VALUE.
  """
  environment: [String!]! = []

  """
  Filenames that mark a Vitest project: Vitest reads its own `vitest.config.*`
  and falls back to `vite.config.*`.
  """
  let configNames: [String!]! = [
    "vitest.config.ts",
    "vitest.config.mts",
    "vitest.config.cts",
    "vitest.config.js",
    "vitest.config.mjs",
    "vitest.config.cjs",
    "vite.config.ts",
    "vite.config.mts",
    "vite.config.cts",
    "vite.config.js",
    "vite.config.mjs",
    "vite.config.cjs",
  ]

  """
  Vitest projects at or below the working directory, keyed by project root.
  """
  projects(ws: Workspace!): VitestProjects! {
    VitestProjects(
      paths: sorted(
        ws
          .findRoots(markers: configNames, exclude: ["**/node_modules/**"])
          .map { root => workspacePath(ws, root) }
          .uniq,
      ),
      tool: self,
    )
  }

  """
  The Vitest project rooted at path, relative to the working directory.
  """
  project(ws: Workspace!, path: String!): VitestProject! {
    projectAt(workspacePath(ws, path))
  }

  let projectAt(path: String!): VitestProject! {
    VitestProject(path: path, tool: self)
  }

  """
  The workspace-root-relative path of a cwd-relative path, "." at the root
  """
  let workspacePath(ws: Workspace!, cwdPath: String!): String! {
    # findRoots answers relative to the workspace cwd -- "." for the cwd
    # itself and ".." for an enclosing project -- while keys are
    # workspace-root-relative.
    let segments = cwdPath.split("/").filter { segment => segment != "" and segment != "." }
    let up = segments.filter { segment => segment == ".." }.length
    let down = segments.filter { segment => segment != ".." }
    let resolved = ws.cwd.split("/").filter { segment => segment != "" }.dropLast(up) + down

    if (resolved.length == 0) { "." } else { resolved.join("/") }
  }

  # Byte-order sort, so keys are stable between runs.
  let sorted(items: [String!]!): [String!]! {
    let empty: [String!]! = []
    items.reduce(empty) { acc, item =>
      acc.takeWhile { x => x <= item } + [item] + acc.dropWhile { x => x <= item }
    }
  }

  let lockfiles: [String!]! = [
    "pnpm-lock.yaml",
    "yarn.lock",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "bun.lock",
    "bun.lockb",
  ]

  """
  Where a project's dependencies are installed: the nearest workspace root at
  or above it (pnpm-workspace.yaml, or a package.json with "workspaces"),
  else the nearest lockfile's directory, else the nearest package.json's.
  Null when there is no package.json at or above the project.
  """
  let installRoot(ws: Workspace!, dir: String!): String {
    let from = "/" + join(dir, "")
    if (ws.findUp("package.json", from) == null) {
      null
    } else {
      let workspaceRoot = nearest([dirOf(ws.findUp("pnpm-workspace.yaml", from)), workspacesRoot(ws, from)])
      let lockRoot = nearest(
        lockfiles.map { name => dirOf(ws.findUp(name, from)) },
      )
      workspaceRoot ?? lockRoot ?? dirOf(ws.findUp("package.json", from))
    }
  }

  """
  The nearest directory at or above from whose package.json declares
  "workspaces", or null.
  """
  let workspacesRoot(ws: Workspace!, from: String!): String {
    let found = ws.findUp("package.json", from)
    if (found == null) {
      null
    } else {
      let dir = dirOf(found) ?? "."
      if (ws.file(found ?? "").contents.contains("\"workspaces\"")) {
        dir
      } else if (dir == ".") {
        null
      } else {
        workspacesRoot(ws, "/" + (dirOf("/" + dir) ?? "."))
      }
    }
  }

  """
  Directory of a workspace path returned by findUp, or null.
  """
  let dirOf(found: String): String {
    if (found == null) {
      null
    } else {
      let p = (found ?? "").split("/").dropLast(1).join("/").trimPrefix("/").trimSuffix("/")
      if (p == "") { "." } else { p }
    }
  }

  """
  The deepest, so nearest, of the given directories on one path, or null.
  """
  let nearest(dirs: [String]!): String {
    let none: String = null
    dirs.reduce(none) { best, dir =>
      if (dir == null) {
        best
      } else if (best == null) {
        dir
      } else if (depth(dir ?? ".") > depth(best ?? ".")) {
        dir
      } else {
        best
      }
    }
  }

  let depth(dir: String!): Int! {
    if (dir == ".") { 0 } else { dir.split("/").length }
  }

  """
  Workspace-root path of name inside dir; dir itself when name is empty.
  """
  let join(dir: String!, name: String!): String! {
    if (dir == ".") { name } else if (name == "") { dir } else { dir + "/" + name }
  }

  let containerPath(dir: String!): String! {
    if (dir == ".") { "/src" } else { "/src/" + dir }
  }

  """
  The configured package manager, else the one root's package.json names in
  "packageManager", else the one its lockfile belongs to, else npm.
  """
  let packageManagerFor(ws: Workspace!, root: String!): String! {
    if (packageManager != "") {
      packageManager
    } else {
      let text = { ws.file("/" + join(root, "package.json")).contents } rescue {
        err: Error => ""
      }
      let declared = if (text.contains("\"packageManager\"")) {
        text.replaceMatches(`(?s)^.*"packageManager"\s*:\s*"([a-zA-Z]+)@.*$`, with: "$1")
      } else {
        ""
      }
      if (["npm", "pnpm", "yarn", "bun"].contains(declared)) {
        declared
      } else if (has(ws, root, "pnpm-lock.yaml") or has(ws, root, "pnpm-workspace.yaml")) {
        "pnpm"
      } else if (has(ws, root, "yarn.lock")) {
        "yarn"
      } else if (has(ws, root, "bun.lock") or has(ws, root, "bun.lockb")) {
        "bun"
      } else {
        "npm"
      }
    }
  }

  let has(ws: Workspace!, dir: String!, name: String!): Boolean! {
    ws.findUp(name, "/" + join(dir, "")) == "/" + join(dir, name)
  }

  """
  Everything the install reads, and nothing else, so editing source files
  does not re-run it. Directories the package manager copies at install time
  (file:, link: and portal: dependencies, injected workspace packages) are
  included whole, and the files packages name as `bin`, so their commands get
  linked; if they cannot be worked out, the whole source is.
  """
  let installInputs(ws: Workspace!, root: String!): Directory! {
    let none: [String!]! = []
    let copied = {
      copiedDirs(ws, root).reduce(none) { acc, dir => acc + [dir, dir + "/**"] } + binFiles(
        ws,
        root,
      )
    } rescue {
      err: Error => ["**"]
    }
    ws.directory(
      "/" + join(root, ""),
      include: [
        "**/package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        ".pnpmfile.cjs",
        "yarn.lock",
        ".yarnrc",
        ".yarnrc.yml",
        ".yarn/releases/**",
        ".yarn/plugins/**",
        ".yarn/patches/**",
        "package-lock.json",
        "npm-shrinkwrap.json",
        "bun.lock",
        "bun.lockb",
        "bunfig.toml",
        "**/.npmrc",
        "patches/**",
      ] + copied,
      exclude: ["**/node_modules"],
    )
  }

  """
  Directories under root, relative to it, whose contents the install copies:
  every file:, link: or portal: dependency named in a package.json (in any
  dependency field, overrides or resolutions), and every workspace package
  marked injected in dependenciesMeta. Paths leaving root are skipped: they
  are not mounted at all.
  """
  let copiedDirs(ws: Workspace!, root: String!): [String!]! {
    let none: [String!]! = []
    let manifests = manifestFiles(ws, root)
    let local = manifests.reduce(none) { acc, file =>
      let dir = file.split("/").dropLast(1).join("/")
      acc + manifestText(ws, root, file).matchAll(`"(?:file|link|portal):([^"]+)"`).map { m =>
        resolvePath(dir, m.captures.join(""))
      }
    }
    let injected = manifests.reduce(none) { acc, file =>
      acc + manifestText(ws, root, file)
        .matchAll(`"([^"]+)"\s*:\s*\{\s*"injected"\s*:\s*true`)
        .map { m => m.captures.join("") }
    }
    let injectedDirs = if (injected.length == 0) {
      none
    } else {
      manifests
        .filter { file =>
          let text = manifestText(ws, root, file)
          injected.any { name => text.contains("\"name\": \"" + name + "\"") or text.contains("\"name\":\"" + name + "\"") }
        }
        .map { file => file.split("/").dropLast(1).join("/") }
    }
    (local + injectedDirs)
      .filter { dir => dir != "" and dir != "." and dir != ".." and dir.hasPrefix("../") == false }
      .uniq
  }

  """
  Files under root, relative to it, that package.json files name as `bin`,
  as a string or as an object of commands.
  """
  let binFiles(ws: Workspace!, root: String!): [String!]! {
    let none: [String!]! = []
    manifestFiles(ws, root)
      .reduce(none) { acc, file =>
        let dir = file.split("/").dropLast(1).join("/")
        let text = manifestText(ws, root, file)
        let single = text.matchAll(`"bin"\s*:\s*"([^"]+)"`).map { m => m.captures.join("") }
        let named = text.matchAll(`"bin"\s*:\s*\{([^}]*)\}`).reduce(none) { found, m =>
          found + m.captures.join("").matchAll(`:\s*"([^"]+)"`).map { v => v.captures.join("") }
        }
        acc + (single + named).map { bin => resolvePath(dir, bin) }
      }
      .filter { file => file != "" and file != ".." and file.hasPrefix("../") == false }
      .uniq
  }

  """
  Every package.json under root except in node_modules, relative to root.
  """
  let manifestFiles(ws: Workspace!, root: String!): [String!]! {
    ws
      .search(
        paths: ["/" + join(root, "")],
        globs: ["package.json", "!node_modules", "!.git"],
        pattern: "",
        filesOnly: true,
      ).{{filePath}}
      .map { result => result.filePath.trimPrefix("/").trimPrefix("./") }
      .map { file => if (root == ".") { file } else { file.trimPrefix(root + "/") } }
  }

  let manifestText(ws: Workspace!, root: String!, file: String!): String! {
    ws.file("/" + join(root, file)).contents
  }

  """
  A path relative to dir, normalized; "" for dir itself, and "../..." when
  it leaves the root.
  """
  let resolvePath(dir: String!, rel: String!): String! {
    let none: [String!]! = []
    let segments = (dir.split("/") + rel.split("/")).filter { s => s != "" and s != "." }
    segments
      .reduce(none) { acc, seg =>
        if (seg == ".." and acc.length > 0 and acc.takeLast(1).join("") != "..") {
          acc.dropLast(1)
        } else {
          acc + [seg]
        }
      }
      .join("/")
  }

  let installCommand(ws: Workspace!, root: String!): [String!]! {
    let pm = packageManagerFor(ws, root)
    # pnpm 12 ignores npm_config_store_dir, and npm warns about it, so the
    # store is named on the command line.
    let none: [String!]! = []
    let store = if (pm == "pnpm") { ["--store-dir", pnpmStore] } else { none }
    [pm, "install"] + store + installFlags
  }

  let pnpmStore: String! = "/root/.pnpm-store"

  """
  Node container with every package manager's cache and the browser download
  directories on volumes, and corepack enabled for pnpm and yarn. Browser
  downloads stay on, since Vitest's browser mode may use them; Cypress's
  binary and git hooks are switched off.
  """
  let nodeBase(pm: String!): Container! {
    let base = container
      .from(baseImageAddress)
      .withMountedCache("/root/.npm", cacheVolume("npm-cache"))
      .withEnvVariable("npm_config_cache", "/root/.npm")
      # Concurrent yarn 1 installs corrupt a shared cache.
      .withMountedCache("/root/.yarn-cache", cacheVolume("yarn-cache"), sharing: CacheSharingMode.LOCKED)
      .withEnvVariable("YARN_CACHE_FOLDER", "/root/.yarn-cache")
      .withMountedCache("/root/.bun-cache", cacheVolume("bun-cache"))
      .withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.bun-cache")
      .withMountedCache("/root/.corepack", cacheVolume("corepack"))
      .withEnvVariable("COREPACK_HOME", "/root/.corepack")
      .withEnvVariable("COREPACK_ENABLE_DOWNLOAD_PROMPT", "0")
      .withEnvVariable("CI", "true")
      # Browsers a dependency downloads while installing (Puppeteer's Chrome)
      # or later (Playwright's) are kept on cache volumes.
      .withMountedCache("/root/.cache/puppeteer", cacheVolume("puppeteer-browsers"))
      .withMountedCache("/root/.cache/ms-playwright", cacheVolume("playwright-browsers"))
      .withEnvVariable("CYPRESS_INSTALL_BINARY", "0")
      .withEnvVariable("HUSKY", "0")
      .withEnvVariable("SKIP_INSTALL_SIMPLE_GIT_HOOKS", "1")
    let ctr = if (pm == "pnpm" or pm == "yarn") {
      # Images from node 25 on no longer ship corepack, and --force replaces
      # the yarn they still ship.
      let withStore = if (pm == "pnpm") {
        base
          .withMountedCache(pnpmStore, cacheVolume("pnpm-store"))
      } else {
        base
      }
      withStore.withExec([
        "sh",
        "-c",
        "command -v corepack >/dev/null 2>&1 || npm install -g --force corepack; corepack enable",
      ])
    } else if (pm == "bun") {
      base.withExec(["sh", "-c", "command -v bun >/dev/null 2>&1 || npm install -g bun"])
    } else {
      base
    }
    environment.reduce(ctr) { acc, pair =>
      let key = pair.replaceMatches(`(?s)=.*$`, with: "")
      acc.withEnvVariable(key, pair.trimPrefix(key + "="))
    }
  }

  """
  The install root with its dependencies installed. The install may have
  failed: read exitCode.
  """
  let installed(ws: Workspace!, root: String!): Container! {
    nodeBase(packageManagerFor(ws, root))
      .withDirectory(containerPath(root), installInputs(ws, root))
      .withWorkdir(containerPath(root))
      .withExec(installCommand(ws, root), expect: ReturnType.ANY)
  }

  """
  Why installing a project's dependencies failed, with the end of its
  output, or null.
  """
  let installFailure(ws: Workspace!, project: VitestProject!): String {
    let root = installRoot(ws, project.path)
    if (root == null) {
      null
    } else {
      let ran = installed(ws, root ?? ".")
      let code = ran.exitCode
      if (code == 0) {
        null
      } else {
        "install failed (" + installCommand(ws, root ?? ".").join(" ") + ", exit " + toString(code) + "):\n"
          + lastLines(ran, 15)
      }
    }
  }

  let lastLines(ran: Container!, count: Int!): String! {
    (ran.stdout.trim(" \n") + "\n" + ran.stderr.trim(" \n")).trim(" \n").split("\n").takeLast(count).join("\n")
  }

  """
  A vitest command that runs the nearest node_modules/.bin/vitest between the
  working directory and the install root, or yarn's under Plug'n'Play, and
  says how to fix it when there is none.
  """
  let wrapper(root: String!): String! {
    let top = containerPath(root)
    "#!/bin/sh\n"
      + "d=\"$PWD\"\n"
      + "while :; do\n"
      + "  if [ -x \"$d/node_modules/.bin/vitest\" ]; then exec \"$d/node_modules/.bin/vitest\" \"$@\"; fi\n"
      + "  if [ \"$d\" = "
      + top
      + " ] || [ \"$d\" = / ]; then break; fi\n"
      + "  d=$(dirname \"$d\")\n"
      + "done\n"
      + "if [ -f "
      + top
      + "/.pnp.cjs ]; then exec yarn vitest \"$@\"; fi\n"
      + "echo \"vitest is not installed: add it to the devDependencies of "
      + join(root, "package.json")
      + " (or of a package.json between it and the project)\" >&2\n"
      + "exit 127\n"
  }

  """
  Container that runs Vitest, with the project as the working directory. With
  a package.json at or above the project, the install root's dependencies are
  installed and the source laid over them; otherwise npx fetches Vitest on
  demand. The install must have succeeded: see installFailure.
  """
  let runner(ws: Workspace!, project: VitestProject!): Container! {
    let root = installRoot(ws, project.path)
    let mount = root ?? project.path
    let source = ws.directory(
      "/" + join(mount, ""),
      exclude: ["**/node_modules", ".git"],
      gitignore: true,
    )
    let ctr = if (root == null) {
      nodeBase("npm").withDirectory(containerPath(mount), source)
    } else {
      installed(ws, root ?? ".")
        .withDirectory(containerPath(mount), source)
        # 493 is 0755.
        .withNewFile("/usr/local/bin/vitest", wrapper(root ?? "."), permissions: 493)
    }
    let extra = if (includeExtraFiles.length > 0) {
      ctr.withDirectory(
        "/src",
        ws.directory("/", include: includeExtraFiles, exclude: ["**/node_modules"]),
      )
    } else {
      ctr
    }
    # A test that uses a Dagger SDK opens a session from inside this container,
    # and a session finds its workspace root by walking up to a .git directory.
    # Without one the nested session gets an empty workspace — no root, no config
    # file — so every workspace-relative API fails, including the serveModule a
    # generated module client calls before its first query.
    #
    # The marker only has to exist, so synthesize an empty one at the workspace
    # root rather than uploading the real git directory. That also covers a
    # workspace built from a Directory, which has no .git to mount. A real one
    # mounted through includeExtraFiles still wins: merging an empty directory
    # over it changes nothing. Tests that read git history need that setting.
    let rooted = extra.withDirectory("/src/.git", directory)
    let workdir = rooted.withWorkdir(containerPath(project.path))
    if (build) {
      workdir.withExec([packageManagerFor(ws, mount), "run", "build"], expect: ReturnType.ANY)
    } else {
      workdir
    }
  }

  """
  The vitest command: npx without a package.json, otherwise the wrapper the
  runner installs, which runs the project's own vitest.
  """
  let vitestCommand(ws: Workspace!, project: VitestProject!): [String!]! {
    if (installRoot(ws, project.path) == null) { ["npx", "--yes", "vitest"] } else { ["vitest"] }
  }

  """
  Why a finished step failed, naming it, or null.
  """
  let stepFailure(ran: Container!, step: String!): String {
    let code = ran.exitCode
    if (code == 0) {
      null
    } else if (code == 127) {
      ran.stderr.trim(" \n")
    } else {
      step + " failed (exit " + toString(code) + "):\n" + lastLines(ran, 15)
    }
  }

  """
  Why the install or the build step of a project failed, naming the step, or
  null.
  """
  let setupFailure(ws: Workspace!, project: VitestProject!): String {
    let install = installFailure(ws, project)
    if (install != null) {
      install
    } else if (build == false) {
      null
    } else {
      stepFailure(runner(ws, project), "build")
    }
  }

  """
  The runner, ready to run vitest after removing the given project-relative
  files: the OpenTelemetry reporter loaded, and the engine reachable.
  """
  let testRunner(ws: Workspace!, project: VitestProject!, remove: [String!]!): Container! {
    let prefix = containerPath(project.path) + "/"
    runner(ws, project)
      .withoutFiles(remove.map { file => prefix + file })
      .withMountedDirectory("/vitest", buildLibrary)
      .withEnvVariable(
        "NODE_OPTIONS",
        "$NODE_OPTIONS --import /vitest/dist/esm/register.mjs",
        expand: true,
      )
      # With its own session a client provisions through a CLI rather than
      # the session environment. The engine mounts a version-matched one
      # here and puts it on PATH, and a TypeScript client built on SDK
      # v1.0.4 or later finds it there by itself.
      #
      # Compatibility shim: an older client only looks at this variable, and
      # fails with "Cannot read properties of undefined (reading 'port')"
      # without it. A client ships its own bundle, so its SDK version is
      # independent of the engine's. Drop this once pre-v1.0.4 clients are
      # out of support; for a newer one it names the binary PATH would
      # have found anyway.
      .withEnvVariable("_EXPERIMENTAL_DAGGER_CLI_BIN", "/dev/.dagger/dagger")
  }

  """
  Run vitest in a project with the given extra arguments, after removing the
  given project-relative files. Returns why it failed, naming the step, or
  null. It never raises, so a collection helper reports every project.
  """
  let vitestFailure(
    ws: Workspace!,
    project: VitestProject!,
    args: [String!]!,
    remove: [String!]!,
  ): String {
    {
      let setup = setupFailure(ws, project)
      if (setup != null) {
        setup
      } else {
        let ran = testRunner(ws, project, remove)
          .withEnvVariable("DAGGER_VITEST_CACHE_BUSTER", UUID.v7)
          # Nested so that tests using a Dagger SDK connect to the session
          # already running them, rather than failing while provisioning an
          # engine of their own. Nested clients get no host access (that stays
          # scoped to the main client), so this hands the tests nothing they
          # could not already reach.
          .withExec(
            vitestCommand(ws, project) + flags + args,
            daggerInDaggerNewSession: true,
            expect: ReturnType.ANY,
          )
        stepFailure(ran, "vitest")
      }
    } rescue {
      err: Error => err.message
    }
  }

  """
  Pinned image the report helper runs in, whatever the base image is.
  """
  let helperImage: Container! {
    container.from("oven/bun:1.3.0-alpine@sha256:37e6b1cbe053939bccf6ae4507977ed957eaa6e7f275670b72ad6348e0d2c11f")
  }

  """
  Indexes the JSON report of a shared run; see the file.
  """
  let reportHelper: File! {
    currentModule.source.file("helpers/vitest-report.mjs")
  }

  """
  Where the shared run writes its report and its output.
  """
  let reportDir: String! = "/dagger-vitest-report"

  """
  Run one vitest command for every selected test check of a project, then
  index its JSON report into one bounded result per check. Every check of
  the project calls this with the same arguments, so the engine runs both
  once. selection holds the selected files and tests, in byte order.
  """
  let sharedRun(
    ws: Workspace!,
    project: VitestProject!,
    args: [String!]!,
    remove: [String!]!,
    selection: [VitestTestSelection!]!,
  ): VitestTestResults! {
    let setup = setupFailure(ws, project)
    if (setup != null) {
      VitestTestResults(results: directory, failure: setup, selection: selection)
    } else {
      # The console reporter keeps the run's summary and errors in the output
      # that failures quote, unless the flags name reporters of their own.
      let none: [String!]! = []
      let console = if (flags.any { flag => flag.hasPrefix("--reporter") }) { none } else { ["--reporter=default"] }
      # No cache buster here: every check of the project must build this
      # exact command, so that the engine runs it once.
      let executed = testRunner(ws, project, remove)
        # Owned by the base image's user, who writes the report.
        .withDirectory(reportDir, directory, inheritOwner: true)
        .withExec(
          vitestCommand(ws, project) + flags + console + [
            "--reporter=json",
            "--outputFile.json=" + reportDir + "/report.json",
          ] + args,
          redirectStdout: reportDir + "/stdout.log",
          redirectStderr: reportDir + "/stderr.log",
          daggerInDaggerNewSession: true,
          expect: ReturnType.ANY,
        )
      let indexed = helperImage
        .withDirectory("/report", executed.directory(reportDir))
        .withFile("/vitest-report.mjs", reportHelper)
        .withNewFile(
          "/selection.json",
          JSON.encode(selection.map { s => {{file: s.file, names: s.names, statics: s.statics}} }),
        )
        .withExec([
          "bun",
          "/vitest-report.mjs",
          "--report", "/report/report.json",
          "--stdout", "/report/stdout.log",
          "--stderr", "/report/stderr.log",
          "--selection", "/selection.json",
          "--root", containerPath(project.path) + "/",
          "--exit-code", `${executed.exitCode}`,
          "--bail", if (flags.any { flag => flag.hasPrefix("--bail") }) { "true" } else { "false" },
          "--output", "/results",
        ])
      VitestTestResults(results: indexed.directory("/results"), failure: null, selection: selection)
    }
  }

  """
  Build the otel library
  """
  let buildLibrary: Directory! {
    let module = currentModule.source.filter(exclude: ["tests", "helpers", "vitest.dang", "dagger-module.toml", ".dagger", "biome.json", "dist", "node_modules"])

    container
      .from("oven/bun:1.3.0-alpine@sha256:37e6b1cbe053939bccf6ae4507977ed957eaa6e7f275670b72ad6348e0d2c11f")
      .withMountedCache("/root/.bun/install/cache", cacheVolume("library-node-modules"))
      .withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.bun/install/cache")
      .withDirectory("/src", module)
      .withWorkdir("/src")
      .withExec(["bun", "install"])
      .withExec(["bun", "run", "build"])
      .directory("/src")
  }
}

"""
Vitest projects in a workspace, keyed by project root.
"""
type VitestProjects @collection {
  """
  Project root paths.
  """
  paths: [String!]! @keys

  """
  Settings every project runs with.
  """
  let tool: Vitest!

  """
  The Vitest project rooted at path.
  """
  project(path: String!): VitestProject! @get {
    tool.projectAt(path)
  }

  """
  Run the tests of the selected Vitest projects.
  """
  test(ws: Workspace!): Void {
    # A selection over a list evaluates its elements concurrently, so all
    # projects run in parallel.
    let failures = paths.map { p => project(p) }.{{path, failure: testFailure(ws)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "Vitest project tests failed:\n" + failures.map { result =>
        "- " + result.path + ": " + (result.failure ?? "")
      }.join("\n")
    }
    null
  }
}


"""
A Vitest project rooted at a workspace-relative path.
"""
type VitestProject {
  """
  Project root, relative to the workspace.
  """
  path: String!

  """
  Settings this project runs with.
  """
  let tool: Vitest!

  """
  Test files in this project, keyed by project-relative path, each holding
  the tests its source names. Listing them runs no container: files come
  from filePaths and names from reading each file (see staticTests).
  """
  testFiles(ws: Workspace!): VitestTestFiles! {
    let files = filePaths(ws)
    # One read of the project's test files rather than one per file.
    let sources = ws.directory(
      if (path == ".") { "/" } else { "/" + path },
      include: ["**/*.test.*", "**/*.spec.*"] + defaultsExtension(configText(ws), "include"),
      exclude: ["**/node_modules", ".git"],
    )
    VitestTestFiles(
      files: files,
      project: self,
      entries: files.map { file =>
        # A file that cannot be read names no test, so it gets the rest key.
        let text = { sources.file(file).contents } rescue {
          err: Error => ""
        }
        let names = staticTests(text)
        VitestTestFileSelection(
          path: file,
          tests: VitestTests(names: names, path: file, project: self),
          statics: tool.sorted(names.filter { name => name != restTest }),
        )
      },
    )
  }

  """
  Run this project's tests.
  """
  test(ws: Workspace!): Void {
    let failure = testFailure(ws)
    if (failure != null) {
      raise "Vitest project " + path + ": " + (failure ?? "")
    }
    null
  }

  """
  List this project's tests.
  """
  list(ws: Workspace!): String {
    listOutput(ws, tool.runner(ws, self).withEnvVariable("DAGGER_VITEST_CACHE_BUSTER", UUID.v7), [])
  }

  # `vitest list` output, restricted to the given test files with their
  # same-named decoys removed. Raises when the install or the listing fails.
  let listOutput(ws: Workspace!, ctr: Container!, files: [String!]!): String! {
    let install = tool.installFailure(ws, self)
    if (install != null) {
      raise "Vitest project " + path + ": " + (install ?? "")
    }
    let prefix = tool.containerPath(path) + "/"
    let listed = ctr
      .withoutFiles(decoys(ws, files).map { file => prefix + file })
      .withExec(
        tool.vitestCommand(ws, self) + ["list"] + files + tool.flags,
        expect: ReturnType.ANY,
      )
    # Vitest can report collection errors on stderr and still exit 0.
    let failure = if (listed.exitCode == 0 and listed.stderr.toLower.contains("unhandled error")) {
      "vitest list failed (unhandled errors):\n" + tool.lastLines(listed, 15)
    } else {
      tool.stepFailure(listed, "vitest list")
    }
    if (failure != null) {
      raise "Vitest project " + path + ": " + (failure ?? "")
    }
    listed.stdout
  }

  """
  This project's source directory.
  """
  source(ws: Workspace!): Directory! {
    ws.directory(
      if (path == ".") { "/" } else { "/" + path },
      exclude: ["**/node_modules", "dist", "build"],
    )
  }

  """
  Why running this project's tests failed, or null when they pass.
  """
  let testFailure(ws: Workspace!): String {
    tool.vitestFailure(ws, self, [], [])
  }

  """
  Run exactly these project-relative test files, with extra vitest arguments.
  """
  let runFiles(ws: Workspace!, files: [String!]!, args: [String!]!): Void {
    let failure = tool.vitestFailure(ws, self, files + args, decoys(ws, files))
    if (failure != null) {
      raise "Vitest project " + path + ": " + (failure ?? "")
    }
    null
  }

  """
  One vitest command and report shared by every selected test check in this
  project. files is the project's test-file collection as the engine hands
  it to each check, filtered by the active selection, tests included.
  """
  let runTests(ws: Workspace!, files: VitestTestFiles!): VitestTestResults! {
    let discovered = files.entries.filter { entry => files.files.contains(entry.path) }
    let selected = discovered.filter { entry => entry.tests.names.length > 0 }
    if (selected.length == 0) {
      raise "no tests selected in Vitest project " + path
    }
    let none: [String!]! = []
    let testsNarrowed = discovered.any { entry => entry.tests.narrowed }
    # Byte order throughout, the order the results are read in, so every
    # check builds the same command and the same selection file.
    let paths = tool.sorted(selected.map { entry => entry.path })
    let selection = paths.map { file =>
      let entry = selected.filter { e => e.path == file }[0]!
      VitestTestSelection(
        file: file,
        names: tool.sorted(entry.tests.names),
        statics: entry.statics,
      )
    }
    if (files.narrowed == false and testsNarrowed == false) {
      # Nothing selected out: a plain vitest, so the project's own config
      # decides what runs, as on the command line.
      tool.sharedRun(ws, self, none, none, selection)
    } else {
      # Every check of the project evaluates this, so the pattern is only
      # built for a run that filters on names.
      let pattern = if (testsNarrowed) { ["-t", namePattern(selection)] } else { none }
      tool.sharedRun(ws, self, paths + pattern, decoys(ws, paths), selection)
    }
  }

  """
  An anchored --testNamePattern matching exactly the selected tests: each
  selected name, and for each file whose rest key is selected, every name
  that is not one of the file's static names.
  """
  let namePattern(selection: [VitestTestSelection!]!): String! {
    let none: [String!]! = []
    let names = tool.sorted(
      selection.reduce(none) { all, s => all + s.names.filter { name => name != restTest } }.uniq,
    )
    let rests = selection.filter { s => s.names.contains(restTest) }.map { s =>
      if (s.statics.length == 0) { ".*" } else {
        "(?!(?:" + s.statics.map { name => escapeName(name) }.join("|") + ")$).*"
      }
    }
    # Vitest before 2 matches the pattern against the name with a leading
    # space: its file suite's empty name, joined to the rest.
    "^ ?(?:" + (names.map { name => escapeName(name) } + rests).join("|") + ")$"
  }

  # Vitest takes file arguments as case-insensitive substring filters, matched
  # against paths relative to each Vitest project's root, so "src/a.test.ts"
  # also selects "src/a.test.tsx" and "lib/src/a.test.ts". A project's own
  # `exclude` overrides --exclude, so instead every other discovered test file
  # that shares a selected file's name is removed from the container first.
  let decoys(ws: Workspace!, files: [String!]!): [String!]! {
    let names = files.map { file => file.split("/").takeLast(1).join("").toLower }
    filePaths(ws).filter { other =>
      files.contains(other) == false and names.any { name => other.toLower.contains(name) }
    }
  }

  # Test files are found by one ripgrep search over the project tree, with
  # Vitest's default include, **/*.{test,spec}.?(c|m)[jt]s?(x), as globs, so
  # it runs no container. node_modules and .git are pruned by the search
  # itself. Config files come back from the same search and mark nested
  # projects, whose files are left out. Search lists only files with content,
  # so empty files are not keys. The order is byte order, so keys are stable.
  #
  # The config is code, so it is not evaluated. Only the form that extends
  # Vitest's defaults is read, from the project's own config file:
  # `include: [...configDefaults.include, 'a/**']` adds files, and
  # `exclude: [...configDefaults.exclude, 'e2e/**']` removes them, for the
  # string literals listed. Any other include or exclude is not seen; a file
  # it excludes still gets a check, which fails saying Vitest did not run it.
  let filePaths(ws: Workspace!): [String!]! {
    let prefix = if (path == ".") { "" } else { path + "/" }
    let found = ws
      .search(
        paths: [if (path == ".") { "/" } else { "/" + path }],
        globs: [
          "*.{test,spec}.{js,ts,jsx,tsx,cjs,cts,mjs,mts,cjsx,ctsx,mjsx,mtsx}",
          "{vitest,vite}.config.{ts,mts,cts,js,mjs,cjs}",
          "!node_modules",
          "!.git",
        ],
        pattern: "",
        filesOnly: true,
      ).{{filePath}}
      .map { result => result.filePath.trimPrefix("/").trimPrefix("./").trimPrefix(prefix) }
    let nested = found
      .filter { file => isConfig(file) and file.contains("/") }
      .map { file => file.split("/").dropLast(1).join("/") }
    let config = configText(ws)
    let added = defaultsExtension(config, "include").reduce(found.filter { file => isConfig(file) == false }) { acc, pattern =>
      acc + globbed(ws, pattern)
    }
    let none: [String!]! = []
    let excluded = defaultsExtension(config, "exclude").reduce(none) { acc, pattern => acc + globbed(ws, pattern) }
    let files = added.filter { file =>
      nested.any { root => file.hasPrefix(root + "/") } == false and excluded.contains(file) == false
    }
    tool.sorted(files.uniq)
  }

  # The text of the project's own config file, the one Vitest reads first,
  # or "" without one.
  let configText(ws: Workspace!): String! {
    let prefix = if (path == ".") { "" } else { path + "/" }
    let present = ws.glob(prefix + "vite*.config.*").map { file => file.split("/").takeLast(1).join("") }
    let own = tool.configNames.filter { name => present.contains(name) }
    if (own.length == 0) { "" } else { ws.file("/" + prefix + own[0]!).contents }
  }

  # The string literals a config lists after spreading Vitest's default
  # setting, as in `exclude: [...configDefaults.exclude, 'e2e/**']`.
  let defaultsExtension(config: String!, setting: String!): [String!]! {
    let none: [String!]! = []
    let arrays = if (setting == "include") {
      config.matchAll(`include\s*:\s*\[\s*\.\.\.configDefaults\.include\s*,([^\]]*)\]`)
    } else {
      config.matchAll(`exclude\s*:\s*\[\s*\.\.\.configDefaults\.exclude\s*,([^\]]*)\]`)
    }
    arrays
      .reduce(none) { acc, m =>
        acc + m.captures.join("").matchAll(`['"]([^'"]+)['"]`).map { lit => lit.captures.join("") }
      }
  }

  # Project-relative files matching a project-relative pattern, outside
  # node_modules and .git.
  let globbed(ws: Workspace!, pattern: String!): [String!]! {
    let prefix = if (path == ".") { "" } else { path + "/" }
    ws
      .glob(prefix + pattern.trimPrefix("./"))
      .map { file => file.trimPrefix("/").trimPrefix("./").trimPrefix(prefix) }
      .filter { file =>
        file.split("/").any { segment => segment == "node_modules" or segment == ".git" } == false
      }
  }

  # Whether a project-relative path names a Vitest or Vite config file.
  let isConfig(file: String!): Boolean! {
    tool.configNames.contains(file.split("/").takeLast(1).join(""))
  }
}

"""
Test files in a Vitest project, keyed by project-relative path.
"""
type VitestTestFiles @collection {
  """
  Test file paths, relative to the project root.
  """
  files: [String!]! @keys

  """
  Test files selected in or out since the collection was discovered.
  """
  delta: CollectionDelta @delta

  """
  Whether the active selection removed test files from this collection.
  Without a delta (a direct API call) it is treated as removed, the safe
  choice.
  """
  narrowed: Boolean! { delta == null or delta!.removedKeys.length > 0 }

  """
  Each test file's tests. The engine filters these collections too when it
  hands a selected test-file collection to a test check.
  """
  entries: [VitestTestFileSelection!]!

  let project: VitestProject!

  """
  The test file at this project-relative path.
  """
  file(path: String!): VitestTestFile! @get {
    VitestTestFile(
      path: path,
      project: project,
      tests: entries.filter { entry => entry.path == path }[0]!.tests,
    )
  }

  """
  Run the selected test files in this project, in one vitest invocation.
  This is a plain function, not a check: `dagger check` runs each test's own
  check instead.
  """
  test(ws: Workspace!): Void {
    # With nothing selected out, run the project as a whole with its own
    # Vitest config rather than naming every file. Without a delta, the
    # explicit list is the safe choice.
    if (narrowed == false) {
      project.test(ws)
    } else if (files.length > 0) {
      project.runFiles(ws, files, [])
    }
    null
  }
}

"""
A test file and its tests, as a test-file collection stores them.
"""
type VitestTestFileSelection {
  """
  Test file path, relative to the project root.
  """
  path: String!

  """
  Tests in this file.
  """
  tests: VitestTests!

  """
  Every name the file's source gives a test, in byte order, whatever the
  selection: the rest key stands for the file's other tests.
  """
  statics: [String!]!
}

"""
A Vitest test file.
"""
type VitestTestFile {
  """
  Test file path, relative to the project root.
  """
  path: String!

  let project: VitestProject!

  """
  Tests in this file, keyed by full name.
  """
  tests: VitestTests!

  """
  Run this test file.
  """
  test(ws: Workspace!): Void {
    project.runFiles(ws, [path], [])
  }
}

"""
Tests in a Vitest test file, keyed by full name.
"""
type VitestTests @collection {
  """
  Full test names, as `vitest list` prints them after the file path: the
  names of the enclosing suites and the test, joined by " > ". The key "*"
  stands for the file's tests its source does not name.
  """
  names: [String!]! @keys

  """
  Tests selected in or out since the collection was discovered.
  """
  delta: CollectionDelta @delta

  """
  Whether the active selection removed tests from this collection. Without a
  delta (a direct API call) it is treated as removed, the safe choice.
  """
  narrowed: Boolean! { delta == null or delta!.removedKeys.length > 0 }

  """
  Test file path, relative to the project root.
  """
  let path: String!

  let project: VitestProject!

  """
  The test with this full name.
  """
  named(name: String!): VitestTest! @get {
    VitestTest(name: name, path: path, project: project)
  }

  """
  Run the selected tests of this file, in one vitest invocation. This is a
  plain function, not a check: `dagger check` runs each test's own check
  instead.
  """
  test(ws: Workspace!): Void {
    # With nothing selected out, or the rest key selected, run the whole
    # file. Without a delta, the explicit names are the safe choice.
    if (narrowed == false or names.contains(restTest)) {
      project.runFiles(ws, [path], [])
    } else if (names.length > 0) {
      project.runFiles(ws, [path], [
        "-t",
        "^ ?(?:" + names.map { name => escapeName(name) }.join("|") + ")$",
      ])
    }
    null
  }
}

"""
A single Vitest test, or "*": the file's tests its source does not name.
"""
type VitestTest {
  """
  Full test name, or "*".
  """
  name: String!

  """
  Test file path, relative to the project root.
  """
  let path: String!

  let project: VitestProject!

  """
  Run this test.

  Every selected test of a project shares one vitest run: selection is the
  project's test-file collection, which `dagger check` fills in, filtered by
  the active selection, so that every check builds the same command.
  """
  test(ws: Workspace!, selection: VitestTestFiles!): Void @check {
    project.runTests(ws, selection).assertPassed(project.path, path, name)
  }
}

"""
The selected tests of one file, as the shared run's helper receives them.
"""
type VitestTestSelection {
  let file: String!
  let names: [String!]!
  let statics: [String!]!
}

"""
The indexed results of one shared run. The helper wrote one bounded file per
selected test, so a check reads only its own, however large the report.
"""
type VitestTestResults {
  let results: Directory!

  """
  Why the run could not start (the install or the build failed), or null.
  """
  let failure: String

  let selection: [VitestTestSelection!]!

  let assertPassed(project: String!, file: String!, name: String!): Void {
    let where = "Vitest project " + project + ", " + file + ": "
    if (failure != null) {
      raise "Vitest project " + project + ": " + (failure ?? "")
    }
    let selected = selection.filter { s => s.file == file }
    if (selected.length == 0) {
      raise where + "the test file is outside the test selection"
    }
    if (selected[0]!.names.contains(name) == false) {
      raise where + "the test is outside the selection: " + name
    }
    # Ranks in the selection's byte order, which the helper wrote the
    # results in, so names and paths never become file names.
    let fileIndex = selection.filter { s => s.file < file }.length
    let testIndex = selected[0]!.names.filter { other => other < name }.length
    let result = results.file(`${fileIndex}` + "/" + `${testIndex}`).contents
    if (result != "") {
      raise where + result
    }
    null
  }
}

# Static test names. Listing never runs Vitest, so a file's tests are read
# from its source: only names written as literals in the source are keys.
# The scanning helpers follow the Jest module's. Offsets are byte offsets, so
# the source is made ASCII first.

# A JS string literal: single, double, or backtick without interpolation.
let stringLiteral = `'(?:[^'\\\n]|\\.)*'|"(?:[^"\\\n]|\\.)*"|` + "`" + `(?:[^` + "`" + `$\\]|\\[\s\S])*` + "`"

# A JS regex literal body and flags.
let regexLiteral = `/(?:[^/\\\n\[*]|\\.|\[(?:[^\]\\\n]|\\.)*\])(?:[^/\\\n\[]|\\.|\[(?:[^\]\\\n]|\\.)*\])*/[a-z]*`

# Comments, strings and regex literals: everything whose brackets are not
# code. A regex literal is recognized only after a character that can precede
# an expression, captured so masking keeps it.
let tokenPattern = `//[^\n]*|/\*[\s\S]*?\*/|` + stringLiteral + `|([:\[,(=!&|?]\s*)` + regexLiteral

# A run of n filler characters.
let fill(n: Int!, char: String!): String! {
  "".padRight(n).replace(" ", char)
}

# Byte length of an ASCII string.
let size(s: String!): Int! { s.split("").length }

# Replace comments, strings and regex literals with filler of the same
# length, so offsets line up with the source while their brackets vanish.
# Comments read as whitespace, literals as an opaque word.
let mask(source: String!): String! {
  source.rewriteMatches(Regexp(tokenPattern)) { m =>
    let lead = m.captures[0] ?? ""
    let char = if (m.string.hasPrefix("/")) { " " } else { "_" }
    lead + fill(m.end - m.start - size(lead), char)
  }
}

# A string literal's value, or null when text is anything else.
let stringValue(text: String!): String {
  let m = text.trimSpace.match(Regexp(`^(?:'((?:[^'\\\n]|\\.)*)'|"((?:[^"\\\n]|\\.)*)"|` + "`" + `([^` + "`" + `$\\]*)` + "`" + `)$`))
  if (m == null) {
    return null
  }
  m.captures.join("").replaceMatches(`\\(.)`, "$1")
}

# The key standing for a file's tests its source does not name.
let restTest: String! = "*"

# A test key as an exact JavaScript regexp alternative. --testNamePattern
# matches a full name whose parts are joined by a space, not the " > " keys
# use, so the parts are escaped and rejoined.
let escapeName(name: String!): String! {
  name.split(" > ").map { part =>
    part.replaceMatches(`([\\^$.|?*+()\[\]{}/])`, with: "\\$1")
  }.join(" ")
}

# A call to a Vitest suite or test function with its modifier chain, up to
# and including the paren that opens its arguments. skipIf and runIf take a
# condition call before the name; each and for take a table.
let vitestCall = `\b(describe|suite|it|test)((?:\s*\.\s*(?:skipIf|runIf)\s*\([^()]*\)|\s*\.\s*[A-Za-z]+)*)\s*\(`

# The same with a tagged template table, test.each`...`, masked to filler.
let taggedCall = `\b(?:describe|suite|it|test)(?:\s*\.\s*[A-Za-z]+)+\s*_`

"""
The tests a file's source names, as `vitest list` prints them after the
file path: the literal names of the enclosing suites and of the test,
joined by " > ". A test is named only when its name is a string literal
and every scope around it is the file's top level, a named suite's
callback, or a plain `{}` block in one of those. Inside a helper
function, a callback, an if/else, a loop, try/catch, switch, or a ternary
or && / || expression, its name and whether it registers at all depend on
the run. Tests modified by
.each, .for or a test.extend fixture, and the tests of a suite that is not
named, are not named either. Such a test, or a file naming no test, adds the
key "*". .skip and .todo tests are not keys; skipIf and runIf tests are.
"""
let staticTests(text: String!): [String!]! {
  let source = text.replaceMatches(`[^\x00-\x7F]`, with: "?")
  let masked = mask(source)
  # Names are read from the source, where the literals survive, and paired
  # by offset with the calls found in the masked source, where brackets and
  # operators in strings and comments are gone.
  let literals = source
    .matchAll(Regexp(vitestCall + `\s*(` + stringLiteral + `)\s*[,)]`))
    .map { m =>
      let value = stringValue(m.captures[2] ?? "") ?? ""
      # Non-ASCII characters were flattened, so a name the source does not
      # hold verbatim was mangled: the pattern would never match it.
      let kept = if (value.contains("?") and text.contains(value) == false) { "" } else { value }
      {{start: m.start, name: kept}}
    }
  # kind: "describe" (a suite's call), "block" (a plain {} block), "brace"
  # (any other {}) or "other" (any other bracket, a test's call included).
  let frames: [{{kind: String!, name: String!, ok: Boolean!, skip: Boolean!}}!]! = []
  let empty: [String!]! = []
  let none = {{kind: "other", name: "", ok: false, skip: false}}
  let state = masked
    .matchAll(Regexp(
      `\.\s*(?:describe|suite|it|test)\b|` + taggedCall + `|` + vitestCall + `|\?\?|\?\.|\?|&&|\|\||[;\n(){}\[\]]`,
    ))
    # cond is the stack depth at which a ternary or a && / || expression is
    # open, or -1: a test call in it, or deeper, registers conditionally.
    .reduce({{stack: frames, out: empty, rest: false, cond: -1}}) { st, m =>
      let token = m.string
      let depth = st.stack.length
      if (token == ")" or token == "}" or token == "]") {
        let stack = st.stack.dropLast(1)
        {{stack: stack, out: st.out, rest: st.rest, cond: if (st.cond > stack.length) { -1 } else { st.cond }}}
      } else if (token == "(" or token == "[") {
        {{stack: st.stack + [none], out: st.out, rest: st.rest, cond: st.cond}}
      } else if (token == "{") {
        # A plain block follows the end of a statement or another brace, or
        # starts a line after a statement left without a semicolon. On the
        # line of a `)`, `=>`, else, try, do or an operator, the brace is a
        # body or an object.
        let raw = masked.truncate(m.start)
        let before = raw.trim(" \t\r\n")
        let afterLine = raw.containsMatch(`\n\s*$`)
          and before.containsMatch(`[)\]\w$]$`)
          and before.containsMatch(`(?:^|[^\w$])(?:else|try|finally|do|return|case|default|typeof|void|new|yield|await|in|of)$`) == false
        let block = before == "" or before.hasSuffix(";") or before.hasSuffix("{") or before.hasSuffix("}") or afterLine
        let kind = if (block) { "block" } else { "brace" }
        {{stack: st.stack + [{{kind: kind, name: "", ok: false, skip: false}}], out: st.out, rest: st.rest, cond: st.cond}}
      } else if (token == ";" or token == "\n") {
        {{stack: st.stack, out: st.out, rest: st.rest, cond: if (st.cond == depth) { -1 } else { st.cond }}}
      } else if (token == "?" or token == "&&" or token == "||") {
        {{stack: st.stack, out: st.out, rest: st.rest, cond: if (st.cond == -1) { depth } else { st.cond }}}
      } else if (token == "??" or token == "?." or token.hasPrefix(".")) {
        # Nullish coalescing, optional chaining, or a member such as
        # regexp.test: nothing declared.
        st
      } else if (token.hasSuffix("_")) {
        # A tagged-template table: its tests are named at runtime.
        {{stack: st.stack, out: st.out, rest: true, cond: st.cond}}
      } else {
        let fn = m.captures[0] ?? ""
        let mods = m.captures[1] ?? ""
        let suite = fn == "describe" or fn == "suite"
        let table = mods.containsMatch(`\.\s*(?:each|for)\b`)
        let fixture = mods.containsMatch(`\.\s*extend\b`)
        # Every enclosing scope is a named suite's call, its callback, or a
        # plain block, and no conditional expression is open.
        let scope = st.stack.reduce({{ok: true, prev: false}}) { acc, f =>
          let fine = (f.kind == "describe" and f.ok) or (f.kind == "brace" and acc.prev) or f.kind == "block"
          {{ok: acc.ok and fine, prev: f.kind == "describe" and f.ok}}
        }
        let name = if (table or fixture) { "" } else {
          literals.filter { l => l.start == m.start }.map { l => l.name }[0] ?? ""
        }
        let skip = mods.containsMatch(`\.\s*(?:skip|todo)\b`) or st.stack.any { f => f.skip }
        let named = scope.ok and st.cond == -1 and name != ""
        if (suite) {
          {{
            stack: st.stack + [{{kind: "describe", name: name, ok: named and table == false, skip: skip}}],
            out: st.out,
            rest: st.rest or table,
            cond: st.cond,
          }}
        } else if (fixture or named == false) {
          # test.extend makes a test function under another name, whose
          # calls this does not see; any other unnamed test is runtime's.
          {{stack: st.stack + [none], out: st.out, rest: true, cond: st.cond}}
        } else if (skip) {
          {{stack: st.stack + [none], out: st.out, rest: st.rest, cond: st.cond}}
        } else {
          let full = (st.stack.filter { f => f.kind == "describe" }.map { f => f.name } + [name]).join(" > ")
          {{stack: st.stack + [none], out: st.out + [full], rest: st.rest, cond: st.cond}}
        }
      }
    }
  let names = state.out.uniq
  if (state.rest or names.length == 0) { names + [restTest] } else { names }
}
