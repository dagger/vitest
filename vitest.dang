"""
Toolchain to execute Vitest tests
"""
type Vitest {
  """
  The base image to use.
  """
  baseImageAddress: String! = "node:25-alpine"

  """
  Package manager that installs dependencies: npm, yarn, pnpm or bun. Empty
  detects it from package.json's packageManager field, else the lockfile,
  else npm.
  """
  packageManager: String! = ""

  """
  Extra workspace-root include patterns mounted alongside the project directory,
  at their workspace-relative paths, so relative imports that escape the project
  resolve as they do on disk. Use this for fixtures or schemas shared with code
  elsewhere in a monorepo, e.g. ["testdata/**", "schema/*.json"].
  """
  includeExtraFiles: [String!]! = []

  """
  Run the package manager's build script before the tests.
  """
  build: Boolean! = false

  """
  Flags to pass to every vitest run.
  """
  flags: [String!]! = []

  """
  Flags appended to the install command, e.g. ["--ignore-scripts"].
  """
  installFlags: [String!]! = []

  """
  Environment variables for the install and the tests, as KEY=VALUE.
  """
  environment: [String!]! = []

  """
  Filenames that mark a Vitest project: Vitest reads its own `vitest.config.*`
  and falls back to `vite.config.*`.
  """
  let configNames: [String!]! = [
    "vitest.config.ts",
    "vitest.config.mts",
    "vitest.config.cts",
    "vitest.config.js",
    "vitest.config.mjs",
    "vitest.config.cjs",
    "vite.config.ts",
    "vite.config.mts",
    "vite.config.cts",
    "vite.config.js",
    "vite.config.mjs",
    "vite.config.cjs",
  ]

  """
  Vitest projects at or below the working directory, keyed by project root.
  """
  projects(ws: Workspace!): VitestProjects! {
    VitestProjects(
      paths: sorted(
        ws
          .findRoots(markers: configNames, exclude: ["**/node_modules/**"])
          .map { root => workspacePath(ws, root) }
          .uniq,
      ),
      tool: self,
    )
  }

  """
  The Vitest project rooted at path, relative to the working directory.
  """
  project(ws: Workspace!, path: String!): VitestProject! {
    projectAt(workspacePath(ws, path))
  }

  let projectAt(path: String!): VitestProject! {
    VitestProject(path: path, tool: self)
  }

  """
  The workspace-root-relative path of a cwd-relative path, "." at the root
  """
  let workspacePath(ws: Workspace!, cwdPath: String!): String! {
    # findRoots answers relative to the workspace cwd -- "." for the cwd
    # itself and ".." for an enclosing project -- while keys are
    # workspace-root-relative.
    let segments = cwdPath.split("/").filter { segment => segment != "" and segment != "." }
    let up = segments.filter { segment => segment == ".." }.length
    let down = segments.filter { segment => segment != ".." }
    let resolved = ws.cwd.split("/").filter { segment => segment != "" }.dropLast(up) + down

    if (resolved.length == 0) { "." } else { resolved.join("/") }
  }

  # Byte-order sort, so keys are stable between runs.
  let sorted(items: [String!]!): [String!]! {
    let empty: [String!]! = []
    items.reduce(empty) { acc, item =>
      acc.takeWhile { x => x <= item } + [item] + acc.dropWhile { x => x <= item }
    }
  }

  let lockfiles: [String!]! = [
    "pnpm-lock.yaml",
    "yarn.lock",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "bun.lock",
    "bun.lockb",
  ]

  """
  Where a project's dependencies are installed: the nearest workspace root at
  or above it (pnpm-workspace.yaml, or a package.json with "workspaces"),
  else the nearest lockfile's directory, else the nearest package.json's.
  Null when there is no package.json at or above the project.
  """
  let installRoot(ws: Workspace!, dir: String!): String {
    let from = "/" + join(dir, "")
    if (ws.findUp("package.json", from) == null) {
      null
    } else {
      let workspaceRoot = nearest([dirOf(ws.findUp("pnpm-workspace.yaml", from)), workspacesRoot(ws, from)])
      let lockRoot = nearest(
        lockfiles.map { name => dirOf(ws.findUp(name, from)) },
      )
      workspaceRoot ?? lockRoot ?? dirOf(ws.findUp("package.json", from))
    }
  }

  """
  The nearest directory at or above from whose package.json declares
  "workspaces", or null.
  """
  let workspacesRoot(ws: Workspace!, from: String!): String {
    let found = ws.findUp("package.json", from)
    if (found == null) {
      null
    } else {
      let dir = dirOf(found) ?? "."
      if (ws.file(found ?? "").contents.contains("\"workspaces\"")) {
        dir
      } else if (dir == ".") {
        null
      } else {
        workspacesRoot(ws, "/" + (dirOf("/" + dir) ?? "."))
      }
    }
  }

  """
  Directory of a workspace path returned by findUp, or null.
  """
  let dirOf(found: String): String {
    if (found == null) {
      null
    } else {
      let p = (found ?? "").split("/").dropLast(1).join("/").trimPrefix("/").trimSuffix("/")
      if (p == "") { "." } else { p }
    }
  }

  """
  The deepest, so nearest, of the given directories on one path, or null.
  """
  let nearest(dirs: [String]!): String {
    let none: String = null
    dirs.reduce(none) { best, dir =>
      if (dir == null) {
        best
      } else if (best == null) {
        dir
      } else if (depth(dir ?? ".") > depth(best ?? ".")) {
        dir
      } else {
        best
      }
    }
  }

  let depth(dir: String!): Int! {
    if (dir == ".") { 0 } else { dir.split("/").length }
  }

  """
  Workspace-root path of name inside dir; dir itself when name is empty.
  """
  let join(dir: String!, name: String!): String! {
    if (dir == ".") { name } else if (name == "") { dir } else { dir + "/" + name }
  }

  let containerPath(dir: String!): String! {
    if (dir == ".") { "/src" } else { "/src/" + dir }
  }

  """
  The configured package manager, else the one root's package.json names in
  "packageManager", else the one its lockfile belongs to, else npm.
  """
  let packageManagerFor(ws: Workspace!, root: String!): String! {
    if (packageManager != "") {
      packageManager
    } else {
      let text = { ws.file("/" + join(root, "package.json")).contents } rescue {
        err: Error => ""
      }
      let declared = if (text.contains("\"packageManager\"")) {
        text.replaceMatches(`(?s)^.*"packageManager"\s*:\s*"([a-zA-Z]+)@.*$`, with: "$1")
      } else {
        ""
      }
      if (["npm", "pnpm", "yarn", "bun"].contains(declared)) {
        declared
      } else if (has(ws, root, "pnpm-lock.yaml") or has(ws, root, "pnpm-workspace.yaml")) {
        "pnpm"
      } else if (has(ws, root, "yarn.lock")) {
        "yarn"
      } else if (has(ws, root, "bun.lock") or has(ws, root, "bun.lockb")) {
        "bun"
      } else {
        "npm"
      }
    }
  }

  let has(ws: Workspace!, dir: String!, name: String!): Boolean! {
    ws.findUp(name, "/" + join(dir, "")) == "/" + join(dir, name)
  }

  """
  Everything the install reads, and nothing else, so editing source files
  does not re-run it. Directories the package manager copies at install time
  (file:, link: and portal: dependencies, injected workspace packages) are
  included whole, and the files packages name as `bin`, so their commands get
  linked; if they cannot be worked out, the whole source is.
  """
  let installInputs(ws: Workspace!, root: String!): Directory! {
    let none: [String!]! = []
    let copied = {
      copiedDirs(ws, root).reduce(none) { acc, dir => acc + [dir, dir + "/**"] } + binFiles(
        ws,
        root,
      )
    } rescue {
      err: Error => ["**"]
    }
    ws.directory(
      "/" + join(root, ""),
      include: [
        "**/package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        ".pnpmfile.cjs",
        "yarn.lock",
        ".yarnrc",
        ".yarnrc.yml",
        ".yarn/releases/**",
        ".yarn/plugins/**",
        ".yarn/patches/**",
        "package-lock.json",
        "npm-shrinkwrap.json",
        "bun.lock",
        "bun.lockb",
        "bunfig.toml",
        "**/.npmrc",
        "patches/**",
      ] + copied,
      exclude: ["**/node_modules"],
    )
  }

  """
  Directories under root, relative to it, whose contents the install copies:
  every file:, link: or portal: dependency named in a package.json (in any
  dependency field, overrides or resolutions), and every workspace package
  marked injected in dependenciesMeta. Paths leaving root are skipped: they
  are not mounted at all.
  """
  let copiedDirs(ws: Workspace!, root: String!): [String!]! {
    let none: [String!]! = []
    let manifests = manifestFiles(ws, root)
    let local = manifests.reduce(none) { acc, file =>
      let dir = file.split("/").dropLast(1).join("/")
      acc + manifestText(ws, root, file).matchAll(`"(?:file|link|portal):([^"]+)"`).map { m =>
        resolvePath(dir, m.captures.join(""))
      }
    }
    let injected = manifests.reduce(none) { acc, file =>
      acc + manifestText(ws, root, file)
        .matchAll(`"([^"]+)"\s*:\s*\{\s*"injected"\s*:\s*true`)
        .map { m => m.captures.join("") }
    }
    let injectedDirs = if (injected.length == 0) {
      none
    } else {
      manifests
        .filter { file =>
          let text = manifestText(ws, root, file)
          injected.any { name => text.contains("\"name\": \"" + name + "\"") or text.contains("\"name\":\"" + name + "\"") }
        }
        .map { file => file.split("/").dropLast(1).join("/") }
    }
    (local + injectedDirs)
      .filter { dir => dir != "" and dir != "." and dir != ".." and dir.hasPrefix("../") == false }
      .uniq
  }

  """
  Files under root, relative to it, that package.json files name as `bin`,
  as a string or as an object of commands.
  """
  let binFiles(ws: Workspace!, root: String!): [String!]! {
    let none: [String!]! = []
    manifestFiles(ws, root)
      .reduce(none) { acc, file =>
        let dir = file.split("/").dropLast(1).join("/")
        let text = manifestText(ws, root, file)
        let single = text.matchAll(`"bin"\s*:\s*"([^"]+)"`).map { m => m.captures.join("") }
        let named = text.matchAll(`"bin"\s*:\s*\{([^}]*)\}`).reduce(none) { found, m =>
          found + m.captures.join("").matchAll(`:\s*"([^"]+)"`).map { v => v.captures.join("") }
        }
        acc + (single + named).map { bin => resolvePath(dir, bin) }
      }
      .filter { file => file != "" and file != ".." and file.hasPrefix("../") == false }
      .uniq
  }

  """
  Every package.json under root except in node_modules, relative to root.
  """
  let manifestFiles(ws: Workspace!, root: String!): [String!]! {
    ws
      .search(
        paths: ["/" + join(root, "")],
        globs: ["package.json", "!node_modules", "!.git"],
        pattern: "",
        filesOnly: true,
      ).{{filePath}}
      .map { result => result.filePath.trimPrefix("/").trimPrefix("./") }
      .map { file => if (root == ".") { file } else { file.trimPrefix(root + "/") } }
  }

  let manifestText(ws: Workspace!, root: String!, file: String!): String! {
    ws.file("/" + join(root, file)).contents
  }

  """
  A path relative to dir, normalized; "" for dir itself, and "../..." when
  it leaves the root.
  """
  let resolvePath(dir: String!, rel: String!): String! {
    let none: [String!]! = []
    let segments = (dir.split("/") + rel.split("/")).filter { s => s != "" and s != "." }
    segments
      .reduce(none) { acc, seg =>
        if (seg == ".." and acc.length > 0 and acc.takeLast(1).join("") != "..") {
          acc.dropLast(1)
        } else {
          acc + [seg]
        }
      }
      .join("/")
  }

  let installCommand(ws: Workspace!, root: String!): [String!]! {
    let pm = packageManagerFor(ws, root)
    # pnpm 12 ignores npm_config_store_dir, and npm warns about it, so the
    # store is named on the command line.
    let none: [String!]! = []
    let store = if (pm == "pnpm") { ["--store-dir", pnpmStore] } else { none }
    [pm, "install"] + store + installFlags
  }

  let pnpmStore: String! = "/root/.pnpm-store"

  """
  Node container with every package manager's cache and the browser download
  directories on volumes, and corepack enabled for pnpm and yarn. Browser
  downloads stay on, since Vitest's browser mode may use them; Cypress's
  binary and git hooks are switched off.
  """
  let nodeBase(pm: String!): Container! {
    let base = container
      .from(baseImageAddress)
      .withMountedCache("/root/.npm", cacheVolume("npm-cache"))
      .withEnvVariable("npm_config_cache", "/root/.npm")
      .withMountedCache("/root/.yarn-cache", cacheVolume("yarn-cache"))
      .withEnvVariable("YARN_CACHE_FOLDER", "/root/.yarn-cache")
      .withMountedCache("/root/.bun-cache", cacheVolume("bun-cache"))
      .withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.bun-cache")
      .withMountedCache("/root/.corepack", cacheVolume("corepack"))
      .withEnvVariable("COREPACK_HOME", "/root/.corepack")
      .withEnvVariable("COREPACK_ENABLE_DOWNLOAD_PROMPT", "0")
      .withEnvVariable("CI", "true")
      # Browsers a dependency downloads while installing (Puppeteer's Chrome)
      # or later (Playwright's) are kept on cache volumes.
      .withMountedCache("/root/.cache/puppeteer", cacheVolume("puppeteer-browsers"))
      .withMountedCache("/root/.cache/ms-playwright", cacheVolume("playwright-browsers"))
      .withEnvVariable("CYPRESS_INSTALL_BINARY", "0")
      .withEnvVariable("HUSKY", "0")
      .withEnvVariable("SKIP_INSTALL_SIMPLE_GIT_HOOKS", "1")
    let ctr = if (pm == "pnpm" or pm == "yarn") {
      # Images from node 25 on no longer ship corepack, and --force replaces
      # the yarn they still ship.
      let withStore = if (pm == "pnpm") {
        base
          .withMountedCache(pnpmStore, cacheVolume("pnpm-store"))
      } else {
        base
      }
      withStore.withExec([
        "sh",
        "-c",
        "command -v corepack >/dev/null 2>&1 || npm install -g --force corepack; corepack enable",
      ])
    } else if (pm == "bun") {
      base.withExec(["sh", "-c", "command -v bun >/dev/null 2>&1 || npm install -g bun"])
    } else {
      base
    }
    environment.reduce(ctr) { acc, pair =>
      let key = pair.replaceMatches(`(?s)=.*$`, with: "")
      acc.withEnvVariable(key, pair.trimPrefix(key + "="))
    }
  }

  """
  The install root with its dependencies installed. The install may have
  failed: read exitCode.
  """
  let installed(ws: Workspace!, root: String!): Container! {
    nodeBase(packageManagerFor(ws, root))
      .withDirectory(containerPath(root), installInputs(ws, root))
      .withWorkdir(containerPath(root))
      .withExec(installCommand(ws, root), expect: ReturnType.ANY)
  }

  """
  Why installing a project's dependencies failed, with the end of its
  output, or null.
  """
  let installFailure(ws: Workspace!, project: VitestProject!): String {
    let root = installRoot(ws, project.path)
    if (root == null) {
      null
    } else {
      let ran = installed(ws, root ?? ".")
      let code = ran.exitCode
      if (code == 0) {
        null
      } else {
        "install failed (" + installCommand(ws, root ?? ".").join(" ") + ", exit " + toString(code) + "):\n"
          + lastLines(ran, 15)
      }
    }
  }

  let lastLines(ran: Container!, count: Int!): String! {
    (ran.stdout.trim(" \n") + "\n" + ran.stderr.trim(" \n")).trim(" \n").split("\n").takeLast(count).join("\n")
  }

  """
  A vitest command that runs the nearest node_modules/.bin/vitest between the
  working directory and the install root, or yarn's under Plug'n'Play, and
  says how to fix it when there is none.
  """
  let wrapper(root: String!): String! {
    let top = containerPath(root)
    "#!/bin/sh\n"
      + "d=\"$PWD\"\n"
      + "while :; do\n"
      + "  if [ -x \"$d/node_modules/.bin/vitest\" ]; then exec \"$d/node_modules/.bin/vitest\" \"$@\"; fi\n"
      + "  if [ \"$d\" = "
      + top
      + " ] || [ \"$d\" = / ]; then break; fi\n"
      + "  d=$(dirname \"$d\")\n"
      + "done\n"
      + "if [ -f "
      + top
      + "/.pnp.cjs ]; then exec yarn vitest \"$@\"; fi\n"
      + "echo \"vitest is not installed: add it to the devDependencies of "
      + join(root, "package.json")
      + " (or of a package.json between it and the project)\" >&2\n"
      + "exit 127\n"
  }

  """
  Container that runs Vitest, with the project as the working directory. With
  a package.json at or above the project, the install root's dependencies are
  installed and the source laid over them; otherwise npx fetches Vitest on
  demand. The install must have succeeded: see installFailure.
  """
  let runner(ws: Workspace!, project: VitestProject!): Container! {
    let root = installRoot(ws, project.path)
    let mount = root ?? project.path
    let source = ws.directory(
      "/" + join(mount, ""),
      exclude: ["**/node_modules", ".git"],
      gitignore: true,
    )
    let ctr = if (root == null) {
      nodeBase("npm").withDirectory(containerPath(mount), source)
    } else {
      installed(ws, root ?? ".")
        .withDirectory(containerPath(mount), source)
        # 493 is 0755.
        .withNewFile("/usr/local/bin/vitest", wrapper(root ?? "."), permissions: 493)
    }
    let extra = if (includeExtraFiles.length > 0) {
      ctr.withDirectory(
        "/src",
        ws.directory("/", include: includeExtraFiles, exclude: ["**/node_modules"]),
      )
    } else {
      ctr
    }
    let workdir = extra.withWorkdir(containerPath(project.path))
    if (build) {
      workdir.withExec([packageManagerFor(ws, mount), "run", "build"], expect: ReturnType.ANY)
    } else {
      workdir
    }
  }

  """
  The vitest command: npx without a package.json, otherwise the wrapper the
  runner installs, which runs the project's own vitest.
  """
  let vitestCommand(ws: Workspace!, project: VitestProject!): [String!]! {
    if (installRoot(ws, project.path) == null) { ["npx", "--yes", "vitest"] } else { ["vitest"] }
  }

  """
  Why a finished step failed, naming it, or null.
  """
  let stepFailure(ran: Container!, step: String!): String {
    let code = ran.exitCode
    if (code == 0) {
      null
    } else if (code == 127) {
      ran.stderr.trim(" \n")
    } else {
      step + " failed (exit " + toString(code) + "):\n" + lastLines(ran, 15)
    }
  }

  """
  Run vitest in a project with the given extra arguments, after removing the
  given project-relative files. Returns why it failed, naming the step, or
  null. It never raises, so a batch reports every project.
  """
  let vitestFailure(
    ws: Workspace!,
    project: VitestProject!,
    args: [String!]!,
    remove: [String!]!,
  ): String {
    {
      let install = installFailure(ws, project)
      let ctr = runner(ws, project)
      let built = if (install != null or build == false) { null } else {
        stepFailure(
          ctr,
          "build",
        )
      }
      if (install != null) {
        install
      } else if (built != null) {
        built
      } else {
        let prefix = containerPath(project.path) + "/"
        let ran = ctr
          .withoutFiles(remove.map { file => prefix + file })
          .withMountedDirectory("/vitest", buildLibrary)
          .withEnvVariable(
            "NODE_OPTIONS",
            "$NODE_OPTIONS --import /vitest/dist/esm/register.mjs",
            expand: true,
          )
          .withEnvVariable("DAGGER_VITEST_CACHE_BUSTER", UUID.v7)
          # Nested so that tests using a Dagger SDK connect to the session
          # already running them, rather than failing while provisioning an
          # engine of their own. Nested clients get no host access (that stays
          # scoped to the main client), so this hands the tests nothing they
          # could not already reach.
          .withExec(
            vitestCommand(ws, project) + flags + args,
            experimentalPrivilegedNesting: true,
            expect: ReturnType.ANY,
          )
        stepFailure(ran, "vitest")
      }
    } rescue {
      err: Error => err.message
    }
  }

  """
  Build the otel library
  """
  let buildLibrary: Directory! {
    let module = currentModule.source.filter(exclude: ["tests", "vitest.dang", "dagger-module.toml", ".dagger", "biome.json", "dist", "node_modules"])

    container
      .from("oven/bun:1.3.0-alpine@sha256:37e6b1cbe053939bccf6ae4507977ed957eaa6e7f275670b72ad6348e0d2c11f")
      .withMountedCache("/root/.bun/install/cache", cacheVolume("library-node-modules"))
      .withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.bun/install/cache")
      .withDirectory("/src", module)
      .withWorkdir("/src")
      .withExec(["bun", "install"])
      .withExec(["bun", "run", "build"])
      .directory("/src")
  }
}

"""
Vitest projects in a workspace, keyed by project root.
"""
type VitestProjects @collection {
  """
  Project root paths.
  """
  paths: [String!]! @keys

  """
  Settings every project runs with.
  """
  let tool: Vitest!

  """
  The Vitest project rooted at path.
  """
  project(path: String!): VitestProject! @get {
    tool.projectAt(path)
  }

  """
  Run the tests of the selected Vitest projects.
  """
  test(ws: Workspace!): Void {
    # A selection over a list evaluates its elements concurrently, so all
    # projects run in parallel.
    let failures = paths.map { p => project(p) }.{{path, failure: testFailure(ws)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "Vitest project tests failed:\n" + failures.map { result =>
        "- " + result.path + ": " + (result.failure ?? "")
      }.join("\n")
    }
    null
  }
}

"""
A Vitest project rooted at a workspace-relative path.
"""
type VitestProject {
  """
  Project root, relative to the workspace.
  """
  path: String!

  """
  Settings this project runs with.
  """
  let tool: Vitest!

  """
  Test files in this project, keyed by project-relative path.
  """
  tests(ws: Workspace!): VitestTestFiles! {
    VitestTestFiles(files: testFiles(ws), project: self)
  }

  """
  Run this project's tests.
  """
  test(ws: Workspace!): Void {
    let failure = testFailure(ws)
    if (failure != null) {
      raise "Vitest project " + path + ": " + (failure ?? "")
    }
    null
  }

  """
  List this project's tests.
  """
  list(ws: Workspace!): String {
    let install = tool.installFailure(ws, self)
    if (install != null) {
      raise "Vitest project " + path + ": " + (install ?? "")
    }
    let listed = tool
      .runner(ws, self)
      .withEnvVariable("DAGGER_VITEST_CACHE_BUSTER", UUID.v7)
      .withExec(tool.vitestCommand(ws, self) + ["list"] + tool.flags, expect: ReturnType.ANY)
    # Vitest can report collection errors on stderr and still exit 0.
    let failure = if (listed.exitCode == 0 and listed.stderr.toLower.contains("unhandled error")) {
      "vitest list failed (unhandled errors):\n" + tool.lastLines(listed, 15)
    } else {
      tool.stepFailure(listed, "vitest list")
    }
    if (failure != null) {
      raise "Vitest project " + path + ": " + (failure ?? "")
    }
    listed.stdout
  }

  """
  This project's source directory.
  """
  source(ws: Workspace!): Directory! {
    ws.directory(
      if (path == ".") { "/" } else { "/" + path },
      exclude: ["**/node_modules", "dist", "build"],
    )
  }

  """
  Why running this project's tests failed, or null when they pass.
  """
  let testFailure(ws: Workspace!): String {
    tool.vitestFailure(ws, self, [], [])
  }

  """
  Run exactly these project-relative test files.
  """
  let runFiles(ws: Workspace!, files: [String!]!): Void {
    # Vitest takes file arguments as case-insensitive substring filters,
    # matched against paths relative to each Vitest project's root, so
    # "src/a.test.ts" also runs "src/a.test.tsx" and "lib/src/a.test.ts".
    # A project's own `exclude` overrides --exclude, so instead every other
    # discovered test file that shares a selected file's name is removed from
    # the container before the run.
    let names = files.map { file => file.split("/").takeLast(1).join("").toLower }
    let decoys = testFiles(ws).filter { other =>
      files.contains(other) == false and names.any { name => other.toLower.contains(name) }
    }
    let failure = tool.vitestFailure(ws, self, files, decoys)
    if (failure != null) {
      raise "Vitest project " + path + ": " + (failure ?? "")
    }
    null
  }

  # Test files are found by one ripgrep search over the project tree, with
  # Vitest's default include, **/*.{test,spec}.?(c|m)[jt]s?(x), as globs, so
  # listing runs no container. The project's own include setting is not read.
  # node_modules and .git are pruned by the search itself. Config files come
  # back from the same search and mark nested projects, whose files are left
  # out. Search lists only files with content, so empty files are not keys.
  # The order is byte order, so keys are stable.
  let testFiles(ws: Workspace!): [String!]! {
    let prefix = if (path == ".") { "" } else { path + "/" }
    let found = ws
      .search(
        paths: [if (path == ".") { "/" } else { "/" + path }],
        globs: [
          "*.{test,spec}.{js,ts,jsx,tsx,cjs,cts,mjs,mts,cjsx,ctsx,mjsx,mtsx}",
          "{vitest,vite}.config.{ts,mts,cts,js,mjs,cjs}",
          "!node_modules",
          "!.git",
        ],
        pattern: "",
        filesOnly: true,
      ).{{filePath}}
      .map { result => result.filePath.trimPrefix("/").trimPrefix("./").trimPrefix(prefix) }
    let nested = found
      .filter { file => isConfig(file) and file.contains("/") }
      .map { file => file.split("/").dropLast(1).join("/") }
    let files = found.filter { file =>
      isConfig(file) == false and nested.any { root => file.hasPrefix(root + "/") } == false
    }
    tool.sorted(files.uniq)
  }

  # Whether a project-relative path names a Vitest or Vite config file.
  let isConfig(file: String!): Boolean! {
    tool.configNames.contains(file.split("/").takeLast(1).join(""))
  }
}

"""
Test files in a Vitest project, keyed by project-relative path.
"""
type VitestTestFiles @collection {
  """
  Test file paths, relative to the project root.
  """
  files: [String!]! @keys

  """
  Test files selected in or out since the collection was discovered.
  """
  delta: CollectionDelta

  let project: VitestProject!

  """
  The test file at this project-relative path.
  """
  file(path: String!): VitestTestFile! @get {
    VitestTestFile(path: path, project: project)
  }

  """
  Run the selected test files in this project.
  """
  test(ws: Workspace!): Void @check {
    # With nothing selected out, run the project as a whole with its own
    # Vitest config rather than naming every file. Without a delta, the
    # explicit list is the safe choice.
    let whole = if (delta == null) {
      false
    } else {
      delta.addedKeys.length == 0 and delta.removedKeys.length == 0
    }
    if (whole) {
      project.test(ws)
    } else if (files.length > 0) {
      project.runFiles(ws, files)
    }
    null
  }
}

"""
A Vitest test file.
"""
type VitestTestFile {
  """
  Test file path, relative to the project root.
  """
  path: String!

  let project: VitestProject!

  """
  Run this test file.
  """
  test(ws: Workspace!): Void @check {
    project.runFiles(ws, [path])
  }
}
